g1 : int;
g2 : immutable int;
g3 : int[3];
g4 : int = 7;
g5 : int[3] = [1, 2, 3];
f1 : file;
gImmArr : immutable int[2];

arr : int[3] = [10, 20, 30];

id : (x: int) int {
    return x;
}

add2 : (p: int, q: int) int {
    r: int;
    r = p + q;
    return r;
}

sum : (a: int, b: int, bias: int = 1) int {
    c: int;
    c = (a + b) + bias;
    return c;
}

use : (v: int[3]) int {
    r: int;
    r = v[0] + v[1] + v[2];
    return r;
}

bumpFirst : (delta: int) int {
    tmp: int;
    arr[0] = arr[0] + delta;
    tmp = arr[0];
    return tmp;
}

zero : () int {
    return 0;
}

main : () void {
  outF : file;
  inF  : file;
  log  : file;     # used with sink

  a : bool = true;
  b : bool = false;
  n : int  = 123;
  s : int  = "hello \"levi\"\\world\n";  # tests \" and \\ and \n

  x : int;
  y : int;

  # arithmetic + precedence chain
  x = (g4 + n) * 2 - 1 / 2;

  # boolean/relational with words and/or and '!'
  x = !(a == b);
  x = (a != b) and (n > 0) or (n >= 0) and (n < 1000) and (n <= 1000);

  # calls (as expressions, not standalone statements)
  y = id(41);
  x = add2(y, 1);
  x = add2(id(5), id(6));

  # arrays: indexing and updates
  g3[0] = g5[1] + 9;
  g3[1] = g3[0] * 2;
  g3[2] = g3[1] / 3;

  # THRASH via symbol and keyword
  x = \\(-o-)//;
  x = thrash;

  # I/O operators
  outF << "hi\n";
  inF >> x;

  # post inc/dec
  x++;
  x--;

  # sink via ellipsis token
  ... log;

  return;
}